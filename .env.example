# Copy this file to .env and fill in real values. Never commit .env itself.

# Required
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# Telegram delivery — create a bot via @BotFather, message it once,
# then visit https://api.telegram.org/bot<TOKEN>/getUpdates to get your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — only needed if you enable the NewsAPI.org collector
# instead of the default free Google News RSS fallback.
NEWSAPI_KEY=

# Optional — Email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
